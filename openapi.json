{
  "openapi": "3.0.3",
  "info": {
    "title": "Presend API",
    "description": "Free utility API: file hashing, UUID generation, Base64 encoding, JWT decoding, URL tracking-parameter cleaning, and IP geolocation. No authentication required.",
    "version": "1.0.0",
    "contact": {
      "url": "https://presend.pages.dev/api"
    },
    "license": {
      "name": "MIT",
      "url": "https://github.com/presendapp/presend/blob/main/LICENSE"
    }
  },
  "servers": [
    {
      "url": "https://presend.pages.dev/api",
      "description": "Production"
    }
  ],
  "paths": {
    "/hash": {
      "post": {
        "summary": "Hash a file",
        "description": "Returns SHA-256, SHA-1 and SHA-512 for a file up to 20MB.",
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Hash results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "size_bytes": {
                      "type": "integer"
                    },
                    "hashes": {
                      "type": "object",
                      "properties": {
                        "sha256": {
                          "type": "string"
                        },
                        "sha1": {
                          "type": "string"
                        },
                        "sha512": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "File too large"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/file-type": {
      "post": {
        "summary": "Detect real file type from binary signature",
        "description": "Detects a file's real type from its binary signature (\"magic bytes\"), and flags a mismatch against the claimed Content-Type -- catches disguised files that slip past naive upload filters.",
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": { "type": "string", "format": "binary" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Detection result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "size_bytes": { "type": "integer" },
                    "claimed_type": { "type": "string", "nullable": true },
                    "detected": {
                      "type": "object",
                      "nullable": true,
                      "properties": {
                        "mime": { "type": "string" },
                        "extension": { "type": "string" },
                        "label": { "type": "string", "nullable": true }
                      }
                    },
                    "mismatch": { "type": "boolean" },
                    "warning": { "type": "string", "nullable": true }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/malware-check": {
      "post": {
        "summary": "Hash a file and check it against known malware",
        "description": "Computes SHA-256 and checks it against MalwareBazaar (abuse.ch), a free database of confirmed malware samples. Only catches already-known samples -- a 'not found' result does not guarantee the file is safe.",
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": { "type": "string", "format": "binary" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Hash and malware check result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "size_bytes": { "type": "integer" },
                    "sha256": { "type": "string" },
                    "malwarebazaar": { "type": "object" },
                    "verdict": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/url-clean": {
      "get": {
        "summary": "Clean a single URL",
        "description": "Strips 60+ tracking parameters from a URL.",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cleaned URL",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "original": {
                      "type": "string"
                    },
                    "clean": {
                      "type": "string"
                    },
                    "removed": {
                      "type": "integer"
                    },
                    "valid": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      },
      "post": {
        "summary": "Clean a batch of URLs",
        "description": "Strips tracking parameters from up to 100 URLs at once.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "urls": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 100
                  }
                },
                "required": [
                  "urls"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cleaned URLs batch"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/uuid": {
      "get": {
        "summary": "Generate UUIDs",
        "description": "Generates up to 100 random UUID v4 values.",
        "parameters": [
          {
            "name": "count",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Generated UUIDs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "uuids": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/base64": {
      "get": {
        "summary": "Encode or decode Base64",
        "parameters": [
          {
            "name": "action",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "encode",
                "decode"
              ]
            }
          },
          {
            "name": "text",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 10000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Encoded/decoded result"
          },
          "400": {
            "description": "Invalid input"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/jwt-decode": {
      "get": {
        "summary": "Decode a JWT",
        "description": "Decodes the header and payload of a JWT. Does not verify the signature.",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Decoded JWT",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "header": {
                      "type": "object"
                    },
                    "payload": {
                      "type": "object"
                    },
                    "signature_verified": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid JWT"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/jwt-verify": {
      "post": {
        "summary": "Verify a JWT's cryptographic signature",
        "description": "Actually verifies the signature (HS256/384/512, RS/PS256/384/512, ES256/384/512) via the Workers-native Web Crypto API, plus exp/nbf claim checks. Unlike /jwt-decode, this performs real cryptographic verification.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token"],
                "properties": {
                  "token": { "type": "string" },
                  "secret": { "type": "string", "description": "Required for HS256/384/512." },
                  "jwk": { "type": "object", "description": "Public key in JWK format, for RS/PS/ES algorithms." },
                  "jwks_url": { "type": "string", "description": "URL to a JWKS document; the key is matched by the token's \"kid\" header." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "header": { "type": "object" },
                    "payload": { "type": "object" },
                    "algorithm": { "type": "string" },
                    "valid": { "type": "boolean" },
                    "time_issues": { "type": "array", "items": { "type": "string" }, "nullable": true }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ip": {
      "get": {
        "summary": "Get caller IP geolocation",
        "description": "Returns the caller's IP with city, country, currency, language, EU flag, and Tor exit-node detection (official Tor Project public list). Geolocation is read directly from Cloudflare's edge \u2014 no third-party API call.",
        "responses": {
          "200": {
            "description": "IP geolocation data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ip": { "type": "string" },
                    "city": { "type": "string", "nullable": true },
                    "region": { "type": "string", "nullable": true },
                    "country": { "type": "string", "nullable": true },
                    "continent": { "type": "string", "nullable": true },
                    "latitude": { "type": "string", "nullable": true },
                    "longitude": { "type": "string", "nullable": true },
                    "postal": { "type": "string", "nullable": true },
                    "timezone": { "type": "string", "nullable": true },
                    "asn": { "type": "integer", "nullable": true },
                    "org": { "type": "string", "nullable": true },
                    "currency": { "type": "string", "nullable": true },
                    "language": { "type": "string", "nullable": true },
                    "is_eu": { "type": "boolean", "nullable": true },
                    "tor": {
                      "type": "object",
                      "properties": {
                        "checked": { "type": "boolean" },
                        "is_tor": { "type": "boolean", "nullable": true }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/timestamp": {
      "get": {
        "summary": "Convert timestamps",
        "description": "Current time, or convert between Unix timestamp and ISO date.",
        "parameters": [
          {
            "name": "unix",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Converted timestamp"
          }
        }
      }
    },
    "/color": {
      "get": {
        "summary": "Convert color formats",
        "description": "Convert between hex, RGB and HSL.",
        "parameters": [
          {
            "name": "hex",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "rgb",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hsl",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Converted color"
          }
        }
      }
    },
    "/user-agent": {
      "get": {
        "summary": "Parse a User-Agent string",
        "parameters": [
          {
            "name": "ua",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Parsed User-Agent"
          }
        }
      }
    },
    "/password": {
      "get": {
        "summary": "Generate a secure password",
        "parameters": [
          {
            "name": "length",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 16,
              "maximum": 128
            }
          },
          {
            "name": "symbols",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1"
              ]
            }
          },
          {
            "name": "uppercase",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1"
              ]
            }
          },
          {
            "name": "numbers",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1"
              ]
            }
          },
          {
            "name": "exclude_ambiguous",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Generated password with entropy estimate"
          }
        }
      }
    },
    "/email-validate": {
      "get": {
        "summary": "Validate an email address",
        "description": "Checks syntax and verifies the domain has a valid MX record.",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Validation result"
          }
        }
      }
    },
    "/favicon": {
      "get": {
        "summary": "Fetch a domain's favicon URL",
        "parameters": [
          {
            "name": "domain",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Favicon URL"
          },
          "400": {
            "description": "Disallowed domain"
          }
        }
      }
    },
    "/csv-json": {
      "get": {
        "summary": "Convert between JSON and CSV (GET)",
        "parameters": [
          {
            "name": "direction",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "json-to-csv",
                "csv-to-json"
              ]
            }
          },
          {
            "name": "data",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Converted data"
          }
        }
      },
      "post": {
        "summary": "Convert between JSON and CSV (POST)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "direction": {
                    "type": "string",
                    "enum": [
                      "json-to-csv",
                      "csv-to-json"
                    ]
                  },
                  "data": {
                    "type": "string"
                  }
                },
                "required": [
                  "direction",
                  "data"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Converted data"
          }
        }
      }
    },
    "/password-breach": {
      "get": {
        "summary": "Check if a password has been breached",
        "description": "Uses HIBP k-anonymity \u2014 only 5 hash chars are sent externally.",
        "parameters": [
          {
            "name": "password",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Breach status"
          }
        }
      }
    },
    "/password-check": {
      "post": {
        "summary": "Combined password strength + breach check",
        "description": "Chains entropy/strength scoring with an optional HIBP breach check in a single call. Password is sent in the JSON body, never in a URL.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["password"],
                "properties": {
                  "password": { "type": "string" },
                  "check_breach": { "type": "boolean", "default": true }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Strength analysis and optional breach result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "length": { "type": "integer" },
                    "entropy_bits": { "type": "integer" },
                    "strength": { "type": "string", "enum": ["very_weak", "weak", "fair", "good", "strong"] },
                    "estimated_crack_time": { "type": "string" },
                    "checks": { "type": "object" },
                    "breach": { "type": "object", "nullable": true }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/email-disposable": {
      "get": {
        "summary": "Detect disposable email domains",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Disposable status"
          }
        }
      }
    },
    "/email-verify": {
      "get": {
        "summary": "Combined email verification",
        "description": "Chains syntax check, MX lookup, disposable-domain detection, and generic/role-account detection in a single call.",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Combined verification result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "email": { "type": "string" },
                    "syntax_valid": { "type": "boolean" },
                    "domain": { "type": "string" },
                    "mx_checked": { "type": "boolean" },
                    "has_mx": { "type": "boolean", "nullable": true },
                    "mx_count": { "type": "integer" },
                    "disposable": { "type": "boolean", "nullable": true },
                    "role_account": { "type": "boolean", "nullable": true },
                    "valid": { "type": "boolean" },
                    "reason": { "type": "string", "nullable": true }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/phone-verify": {
      "get": {
        "summary": "Validate and format a phone number",
        "description": "Validates and formats via libphonenumber-js. If \u201ccountry\u201d is omitted for a number without a leading +, the caller's IP-derived country (Cloudflare edge geolocation) is used as the default.",
        "parameters": [
          {
            "name": "number",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "ISO 3166-1 alpha-2 country code (e.g. US, FR), used to interpret a number with no leading +.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Validation and formatting result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "number": { "type": "string" },
                    "valid": { "type": "boolean" },
                    "country": { "type": "string", "nullable": true },
                    "country_calling_code": { "type": "string", "nullable": true },
                    "type": { "type": "string", "nullable": true },
                    "formats": {
                      "type": "object",
                      "nullable": true,
                      "properties": {
                        "e164": { "type": "string" },
                        "international": { "type": "string" },
                        "national": { "type": "string" },
                        "uri": { "type": "string" }
                      }
                    },
                    "default_country_used": { "type": "string", "nullable": true },
                    "ip_inferred_country": { "type": "string", "nullable": true }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/email-security": {
      "get": {
        "summary": "Domain email anti-spoofing check (SPF/DMARC/DKIM)",
        "description": "Checks SPF strength, DMARC policy, and a best-effort DKIM lookup against common selectors. DKIM has no fixed DNS location, so absence of a match does not prove DKIM is unconfigured.",
        "parameters": [
          {
            "name": "domain",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Anti-spoofing configuration report",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "domain": { "type": "string" },
                    "score": { "type": "integer" },
                    "verdict": { "type": "string" },
                    "spf": { "type": "object" },
                    "dmarc": { "type": "object" },
                    "dkim": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/security-scan": {
      "get": {
        "summary": "Combined security posture report",
        "description": "Combines security-headers, url-reputation, and subdomains into a single overall score and verdict, run in parallel.",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Combined security report",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "url": { "type": "string" },
                    "domain": { "type": "string" },
                    "overall_score": { "type": "integer" },
                    "overall_grade": { "type": "string" },
                    "verdict": { "type": "string" },
                    "security_headers": { "type": "object" },
                    "reputation": { "type": "object" },
                    "attack_surface": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/qr-scan": {
      "post": {
        "summary": "Decode a QR code and check its URL reputation",
        "description": "Decodes a QR code from an uploaded JPEG/PNG image. If the content is a URL, checks it against URLhaus for malware/phishing indicators in the same call. QR-code phishing (\"quishing\") is one of the fastest-growing phishing vectors, bypassing text-based filters.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary", "description": "JPEG or PNG image, max 10MB." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decoded content and, if applicable, reputation check",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "found": { "type": "boolean" },
                    "content": { "type": "string", "nullable": true },
                    "is_url": { "type": "boolean", "nullable": true },
                    "reputation": { "type": "object", "nullable": true },
                    "verdict": { "type": "string", "nullable": true }
                  }
                }
              }
            }
          }
        }
      }
    },
