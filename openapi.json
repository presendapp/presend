    "/merge-and-compress-pdf": {
      "post": {
        "summary": "Merge and compress PDFs",
        "description": "Merges 2+ PDF files into one document, then compresses the result and strips metadata (title, author, producer). Chains two operations in a single call — most free APIs require calling merge and compress separately and gluing the results together yourself.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    },
                    "description": "2 or more PDF files, max 20 files / 30MB total."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Merged and compressed PDF file",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/clean-image": {
      "post": {
        "summary": "Strip image metadata (EXIF/GPS)",
        "description": "Removes EXIF/GPS data from JPEG (APP1 segment) and text metadata from PNG (tEXt/zTXt/iTXt/eXIf/tIME chunks) via direct binary parsing. Pixel data is never re-encoded, so there is zero quality loss — unlike canvas-based approaches, which always recompress.",
        "requestBody": {
          "required": true,
          "content": {
            "image/jpeg": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/png": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cleaned image, same format as input",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/image-similarity": {
      "post": {
        "summary": "Perceptual image hash / similarity comparison",
        "description": "Computes a perceptual hash (dHash, 64-bit) for 1 or 2 JPEG/PNG images. Unlike a cryptographic hash, this survives re-compression, minor resizing, and small edits. Send 2 images to get a direct similarity comparison.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "files": {
                    "type": "array",
                    "items": { "type": "string", "format": "binary" },
                    "description": "1 file (hash only) or 2 files (compare). JPEG/PNG, max 10MB each."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Hash (1 file) or comparison result (2 files)",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/text-similarity": {
      "post": {
        "summary": "Text similarity via SimHash (1 or 2 texts)",
        "description": "Computes a 64-bit SimHash (over word shingles) for 1 or 2 texts. Unlike a cryptographic hash, this detects paraphrased or lightly-edited near-duplicate content. Send 2 texts to get a direct similarity comparison. Unrelated texts typically score ~50% by chance, not 0%.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["texts"],
                "properties": {
                  "texts": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "1 text (hash only) or 2 texts (compare). Max 200,000 characters each."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Hash (1 text) or comparison result (2 texts)",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    }
  }
}